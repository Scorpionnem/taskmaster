{
    "tasks": {
        "server":  {
            "cmds": ["/usr/bin/python3", "main.py"],

            "num_procs": 2,
            "auto_start": true,

            "auto_restart": "unexpected",
            "exitcodes": [0, 2],

            "start_time": 5,
