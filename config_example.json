            "stop_time": 10,

            "stdout": "./stdout.log",
            "stderr": "./stderr.log",

            "env": {
                "USER": "mbatty",
                "DATA": "123"
            },

            "working_dir": "/var/www/html",

            "umask": "022"
        }
    }
}